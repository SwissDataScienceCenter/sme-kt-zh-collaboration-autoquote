# Set to false only when serving over plain http (local development)
SESSION_COOKIE_SECURE=false

# Any server implementing the OpenAI Responses API. Leave LLM_BASE_URL empty for OpenAI, or e.g. http://localhost:11434/v1 for Ollama
LLM_BASE_URL=
LLM_API_KEY=<api-key>
LLM_MODEL=<model-name>

# Embedding model on the same server, used to find similar past requests and offers (e.g. text-embedding-3-small, nomic-embed-text)
EMBEDDING_MODEL=<embedding-model-name>
